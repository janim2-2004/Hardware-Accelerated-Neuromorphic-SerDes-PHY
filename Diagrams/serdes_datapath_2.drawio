        <mxCell id="c83" value="The local LFSR runs from its own state in CHECK, so one line error counts once (no error multiplication). Same polynomial as TX-1. Target: ≥ 3×10⁹ compared bits for a 1e-9 claim, so bit_cnt needs ≥ 32 bits (48 suggested)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#b3a14d;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="c51">
