        <mxCell id="c4" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;fontSize=11;fontFamily=Helvetica;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot;&gt;&lt;tr style=&quot;background:#e8e8e8&quot;&gt;&lt;th style=&quot;border:1px solid #999;padding:3px 6px;text-align:left&quot;&gt;Side&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px 6px;text-align:left&quot;&gt;Signal&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px 6px;text-align:left&quot;&gt;Width&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px 6px;text-align:left&quot;&gt;From → To&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px 6px;text-align:left&quot;&gt;Clock domain&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px 6px;text-align:left&quot;&gt;Interface&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px 6px;text-align:left&quot;&gt;Notes&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f3f7fd&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;TX&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;cfg_prbs_order&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;I5 regs → PRBS gen&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;tx_bit_clk&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;I5&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;00=7, 01=15, 10=23, 11=31&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f3f7fd&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;TX&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;cfg_seed&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;31&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;I5 regs → PRBS gen&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;tx_bit_clk&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;I5&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;non-zero; low &lt;i&gt;order&lt;/i&gt; bits used&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f3f7fd&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;TX&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;cfg_tx_en&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;I5 regs → PRBS gen&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;tx_bit_clk&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;I5&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;hold LFSR when low&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f3f7fd&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;TX&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;tx_data&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;W (1 or 8)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;PRBS → line enc → serializer&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;tx_bit_clk&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;W=8 only with OSERDESE2&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f3f7fd&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;TX&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;tx_serial&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;serializer → OBUFDS&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;40 ns UI&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f3f7fd&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;TX&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;cfg_loopback&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;I5 regs → RX loopback mux&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;sample_clk&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;I5&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;0 = external pins, 1 = internal RTL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f3f7fd&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;TX&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;tx_p / tx_n&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;diff&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;OBUFDS → header pins&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;LVDS_25&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f2f9f1&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;RX&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;rx_p / rx_n&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;diff&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;header pins → IBUFDS&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;DIFF_TERM = TRUE&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f2f9f1&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;RX&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;rx_serial&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;IBUFDS → capture&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;async&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;asynchronous to sample_clk&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f2f9f1&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;RX&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;sample_clk&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;RX MMCM → capture, CDR&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;100 MHz, DCO phase-shifted&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f2f9f1&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;RX&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;samp&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;4 (OSR)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;capture → CDR&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;sample_clk&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;I1&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;one UI of samples&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f2f9f1&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;RX&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;samp_valid&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;capture → CDR&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;sample_clk&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;I1&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;1 pulse per UI&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f2f9f1&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;RX&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;rec_bit, rec_valid&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;1 + 1&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;CDR → deserializer&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;sample_clk&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;center sample chosen by CDR&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f2f9f1&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;RX&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;locked&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;CDR lock det. → BER, telemetry&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;sample_clk&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;I4&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;gates BER counting&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f2f9f1&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;RX&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;rx_word, word_valid&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;8 + 1&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;deserializer → aligner, BER&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;sample_clk*&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;MSB first&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f2f9f1&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;RX&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;bitslip&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;aligner → deserializer&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;sample_clk*&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;optional&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f2f9f1&quot;&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;RX&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;err_cnt&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px 6px;&quot;&gt;32&lt;/td&gt;&lt;td sty